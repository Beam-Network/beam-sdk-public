###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - SENSITIVE INFORMATION                  ###
### DO NOT STORE RAW SECRETS HERE IN PLAINTEXT IF AVOIDABLE                 ###
### DO NOT UPLOAD OR SHARE THIS FILE UNDER ANY CIRCUMSTANCES                ###
###############################################################################
# Ethereum private key or 1Password reference (e.g. op://vault/item/field)
CRE_ETH_PRIVATE_KEY=
# Target to use: staging-settings (Beam DEV, Sepolia) or production-settings
CRE_TARGET=staging-settings
# Beam API key (b1m_...) of the account whose transfers this workflow reads
BEAM_API_KEY=
# Beam organization id that owns the Rooms whose receipts this workflow reads
BEAM_ORG_ID=
# start-transfer: the Studio inbound webhook URL, https://<studio>/hooks/workflows/<workflowId>/<triggerId>/<token>
CRE_STUDIO_WEBHOOK_URL=
# start-transfer: the trigger's signing secret, when config signDeliveries is true
CRE_STUDIO_WEBHOOK_SIGNING_SECRET=
# start-transfer: the Room workflow's webhook URL and signing secret, used with startRoomDeliveries
# (any non-empty value when Room deliveries are off: CRE requires every declared secret)
CRE_STUDIO_ROOM_WEBHOOK_URL=
CRE_STUDIO_ROOM_WEBHOOK_SIGNING_SECRET=
