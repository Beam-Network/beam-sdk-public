{
  "name": "@beam-network/web-sdk-server",
  "version": "0.1.0",
  "description": "Server-side token broker for @beam-network/web-sdk. Mints short-lived scoped browser tokens and proxies the Beam control plane.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/express": {
      "import": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "require": {
        "types": "./dist/adapters/express.d.cts",
        "default": "./dist/adapters/express.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adapters/express": [
        "./dist/adapters/express.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:check": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@beam-network/sdk": ">=0.5.0 || 0.5.17-dev.2"
  },
  "peerDependenciesMeta": {
    "@beam-network/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "beam",
    "beam-network",
    "token",
    "broker",
    "sdk",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beam-Network/beam-sdk-public.git",
    "directory": "packages/web-sdk-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.10.5",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
